{
  "name": "eyesay",
  "version": "2.0.0",
  "private": true,
  "description": "(Eye)Say — blink-driven assistive communication for people living with paralysis or Locked-In Syndrome",
  "main": "server/start.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --dev",
    "start": "node server/start.js",
    "dev": "node scripts/build.js --dev --watch & node --watch-path=server server/start.js",
    "test": "node --test \"tests/*.test.js\"",
    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "angular": "1.8.3",
    "angular-animate": "1.8.3",
    "angular-aria": "1.8.3",
    "angular-material": "1.2.5",
    "angular-svg-round-progressbar": "0.4.8",
    "angular-ui-router": "0.4.3",
    "bootstrap": "3.4.1",
    "esbuild": "^0.28.2",
    "mongodb-memory-server-core": "^11.3.0",
    "sass": "^1.107.0",
    "supertest": "^7.3.1"
  }
}
